//- Кнопка або посилання-кнопка (БЕМ-блок button).
//- text - підпис, href - адреса (без href буде <button>), variant - необов'язковий модифікатор (`block` -> button--block).
//-   +btn('View all', '#categories')
//-   +btn('Send', null, 'block')(type='submit')
mixin btn(text, href, variant)
  -
    const cls = ['button']
    if (variant) cls.push(`button--${variant}`)

  if href
    a(class=cls, href=href)&attributes(attributes)= text
  else
    button(class=cls)&attributes(attributes)= text
