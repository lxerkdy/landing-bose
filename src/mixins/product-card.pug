//- Картка товару (БЕМ-блок product-card). Зовнішні відступи й позиціювання задає батько через мікс.
mixin product-card(product)
  article.product-card&attributes(attributes)
    a.product-card__media(href='#', aria-label=product.name)
      +picture(product.image, '', {
        widths: [320],
        sizes: '(min-width: 1260px) 324px, (min-width: 744px) 392px, 280px',
        width: 320,
        height: 272,
        className: 'product-card__img',
        pictureClass: 'product-card__picture',
      })
    .product-card__body
      h3.product-card__name= product.name
      p.product-card__type= product.type
      p.product-card__price= product.price
