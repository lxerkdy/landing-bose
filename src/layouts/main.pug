//- Базовий макет: описує каркас сторінки та «дірки» (block), які заповнюють сторінки
include ../mixins/index

doctype html
html(lang='en')
  head
    block meta
      meta(charset='utf-8')
      meta(name='viewport', content='width=device-width, initial-scale=1')
    block title
      title Bose
    block styles
      link(rel='stylesheet', href='/src/styles/main.scss')
  body#top
    block data
    block header
    block content
    block footer
