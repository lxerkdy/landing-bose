//- Базовий макет: описує каркас сторінки та «дірки» (block), які заповнюють сторінки
include ../mixins/index

doctype html
html(lang='en')
  head
    block meta
      meta(charset='utf-8')
      meta(name='viewport', content='width=device-width, initial-scale=1')
      meta(
        name='description',
        content='Bose headphones, speakers and audio sunglasses. Free 2-day shipping and returns, 90-day risk-free trial when you buy direct from Bose.'
      )
    block title
      title Bose
    link(rel='icon', href='/favicon.svg', type='image/svg+xml')
    link(rel='preconnect', href='https://fonts.googleapis.com')
    link(rel='preconnect', href='https://fonts.gstatic.com', crossorigin)
    link(
      rel='stylesheet',
      href='https://fonts.googleapis.com/css2?family=Inter:ital,wght@0,400;0,500;0,600;0,700;1,800&display=swap'
    )
    block styles
      link(rel='stylesheet', href='/src/styles/main.scss')
  body#top
    block data
    include ../includes/sprite.svg
    .page
      block header
      block content
